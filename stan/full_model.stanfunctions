// full_model.stanfunctions
// Tuple-returning helpers for full-model grid flag computations.
// #included inside functions {} in model files.

/**
 * Compute process-noise presence and full-state-grid requirement flags.
 *
 * need_states_full_grid is true when any of these hold:
 *   - Process noise (AR(1) state noise) is enabled
 *   - The explicit full-grid flag is set
 *   - Time-varying covariates flow through the multistate 0->1 transition
 *     (ungated or gated+latent), 0->2, or 0->3 transitions, AND no inline
 *     burden path is available for the calling model.
 *
 * ms_needs_inline_burden is true when:
 *   - Process noise is disabled (no states_full_grid built by state_space)
 *   - Population TV covariates are enabled with at least one covariate
 *   - Any of: 0->2 TV cov, 0->3 TV cov, or visit-gated 0->1 with latent burden
 *   - The calling model has an inline burden-covariate computation
 *     (has_inline_tv_covar = 1). Currently only the PSA model does.
 *
 * Models without an inline path (e.g. the tumor SLD model) must build
 * states_full_grid instead, even when process noise is off.
 *
 * @param has_inline_tv_covar  Caller capability flag. 1 if the model file
 *   includes a TV-covariate inline populator (e.g. stan/psa/_psa_inline_tv_covar.stan)
 *   that can fill ms_time_varying_covar_01 without states_full_grid; 0 otherwise.
 *
 * @return (enable_any_process_noise_tr, need_states_full_grid, ms_needs_inline_burden)
 */
tuple(int, int, int) compute_full_model_grid_flags(
  int enable_pop_process_noise_tr,
  int enable_patient_process_noise_tr,
  int enable_states_full_grid,
  int enable_ms_pop_time_varying_cov,
  int n_time_varying_covar,
  int enable_ms_01,
  int enable_ms_visit_gated_01,
  int enable_ms_visit_gated_latent_01,
  int enable_ms_02_time_varying_cov,
  int enable_ms_03_time_varying_cov,
  int has_inline_tv_covar
) {
  int any_pn = enable_pop_process_noise_tr || enable_patient_process_noise_tr;

  // Inline burden: MS needs modeled burden but process noise is OFF, AND
  // the calling model provides an inline computation path. Models without
  // an inline path (e.g. the tumor SLD model) build states_full_grid instead.
  int needs_inline = has_inline_tv_covar && !any_pn &&
    enable_ms_pop_time_varying_cov && n_time_varying_covar > 0 &&
    (enable_ms_02_time_varying_cov || enable_ms_03_time_varying_cov ||
     (enable_ms_visit_gated_01 && enable_ms_visit_gated_latent_01));

  // Full grid needed when: process noise OR explicit flag OR any transition
  // needs the continuous burden trajectory and cannot go inline.
  int need_grid = any_pn || enable_states_full_grid ||
    (enable_ms_pop_time_varying_cov && n_time_varying_covar > 0 && !needs_inline &&
     ((enable_ms_01 && !enable_ms_visit_gated_01) ||
      (enable_ms_visit_gated_01 && enable_ms_visit_gated_latent_01) ||
      enable_ms_02_time_varying_cov || enable_ms_03_time_varying_cov));

  return (any_pn, need_grid, needs_inline);
}
