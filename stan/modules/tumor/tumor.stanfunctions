// ============================================================================
// RECIST RESPONSE EVALUATION FUNCTIONS
// ============================================================================
// Functions for calculating RECIST (Response Evaluation Criteria In Solid Tumors)
// response categories from tumor measurements.

/**
 * Calculate RECIST status based on target lesions only with proper nadir tracking
 */
array[] int calculate_target_recist(vector sld_trajectory, real pre_nadir, int n_screening) {
  int n = rows(sld_trajectory);
  assert_greater_than_or_equal(n, n_screening);
  int n_treat = n - n_screening;
  array[n_treat] int target_status;
  real baseline = sld_trajectory[n_screening];
  real nadir = pre_nadir <= 0 ? baseline : pre_nadir;
  int CR = 1; int PR = 2; int SD = 3; int PD = 4;
  for (t in (n_screening + 1):n) {
    nadir = fmin(nadir, sld_trajectory[t]);
    if (sld_trajectory[t] == 0) {
      target_status[t - n_screening] = CR;
    } else if (nadir > 0 && sld_trajectory[t] > nadir && (sld_trajectory[t] - nadir) / nadir >= 0.2 && (sld_trajectory[t] - nadir) >= 5) {
      target_status[t - n_screening] = PD;
    } else if ((sld_trajectory[t] - baseline) / baseline <= -0.3) {
      target_status[t - n_screening] = PR;
    } else {
      target_status[t - n_screening] = SD;
    }
  }
  return target_status;
}

array[] int calculate_target_recist(vector sld_trajectory, int n_screening) {
  return calculate_target_recist(sld_trajectory, min(sld_trajectory[:n_screening]), n_screening);
}

array[] int calculate_recist(vector sld_trajectory, array[] int new_lesions, array[] int non_target_status, int n_screening) {
  int n = rows(sld_trajectory);
  assert_greater_than_or_equal(n, n_screening);
  int n_treat = n - n_screening;
  array[n_treat] int recist_status;
  int CR = 1; int PR = 2; int SD = 3; int PD = 4;
  int NT_CR = 1; int NT_STABLE = 2; int NT_PD = 3;
  array[n_treat] int target_status = calculate_target_recist(sld_trajectory, n_screening);
  for (t in 1:n_treat) {
    if (new_lesions[t] == 1 || non_target_status[t] == NT_PD || target_status[t] == PD) {
      recist_status[t] = PD;
    } else if (target_status[t] == CR && non_target_status[t] == NT_CR) {
      recist_status[t] = CR;
    } else if (target_status[t] == PR && non_target_status[t] != NT_PD) {
      recist_status[t] = PR;
    } else {
      recist_status[t] = SD;
    }
  }
  return recist_status;
}

array[] int calculate_best_overall_response(array[] int recist_status) {
  int n = size(recist_status);
  array[n] int best_response;
  best_response[1] = recist_status[1];
  for (t in 2:n) {
    best_response[t] = min(best_response[t-1], recist_status[t]);
  }
  return best_response;
}

tuple(int, vector, real, real, int, int) update_recist_metrics(
  int obs_cat, int pred_cat,
  int correct_predictions, vector category_counts,
  real weighted_acc_linear, real weighted_acc_quad,
  int correct_response, int correct_control
) {
  int updated_correct_predictions = correct_predictions;
  vector[4] updated_category_counts = category_counts;
  real updated_weighted_acc_linear = weighted_acc_linear;
  real updated_weighted_acc_quad = weighted_acc_quad;
  int updated_correct_response = correct_response;
  int updated_correct_control = correct_control;
  if (obs_cat == pred_cat) {
    updated_correct_predictions += 1;
  }
  updated_category_counts[obs_cat] += 1;
  int cat_diff = abs(obs_cat - pred_cat);
  updated_weighted_acc_linear += 1.0 - cat_diff / 3.0;
  updated_weighted_acc_quad += 1.0 - square(cat_diff) / 9.0;
  int obs_response = (obs_cat <= 2) ? 1 : 0;
  int pred_response = (pred_cat <= 2) ? 1 : 0;
  if (obs_response == pred_response) {
    updated_correct_response += 1;
  }
  int obs_control = (obs_cat <= 3) ? 1 : 0;
  int pred_control = (pred_cat <= 3) ? 1 : 0;
  if (obs_control == pred_control) {
    updated_correct_control += 1;
  }
  return (updated_correct_predictions, updated_category_counts,
          updated_weighted_acc_linear, updated_weighted_acc_quad,
          updated_correct_response, updated_correct_control);
}

tuple(real, real, real, real, real, vector, vector, real, real, real, real) 
calculate_recist_summary_metrics(
  int correct_predictions, int total_predictions,
  matrix confusion_matrix, vector category_counts,
  real weighted_acc_linear, real weighted_acc_quad,
  int correct_response, int correct_control
) {
  real accuracy = total_predictions > 0 ? (correct_predictions * 1.0 / total_predictions) : 0;
  real response_accuracy = total_predictions > 0 ? (correct_response * 1.0 / total_predictions) : 0;
  real disease_control_accuracy = total_predictions > 0 ? (correct_control * 1.0 / total_predictions) : 0;
  real weighted_linear = total_predictions > 0 ? (weighted_acc_linear / total_predictions) : 0;
  real weighted_quadratic = total_predictions > 0 ? (weighted_acc_quad / total_predictions) : 0;
  vector[4] category_sensitivity = zeros_vector(4);
  vector[4] category_precision = zeros_vector(4);
  for (cat in 1:4) {
    if (category_counts[cat] > 0) {
      category_sensitivity[cat] = confusion_matrix[cat, cat] / category_counts[cat];
    }
    real pred_count = sum(confusion_matrix[, cat]);
    if (pred_count > 0) {
      category_precision[cat] = confusion_matrix[cat, cat] / pred_count;
    }
  }
  real response_sensitivity = 0;
  real response_specificity = 0;
  real progression_sensitivity = 0;
  real progression_specificity = 0;
  real true_responders = sum(category_counts[1:2]);
  real true_non_responders = sum(category_counts[3:4]);
  real true_progressors = category_counts[4];
  real true_non_progressors = sum(category_counts[1:3]);
  if (true_responders > 0) {
    response_sensitivity = sum(confusion_matrix[1:2, 1:2]) / true_responders;
  }
  if (true_non_responders > 0) {
    response_specificity = sum(confusion_matrix[3:4, 3:4]) / true_non_responders;
  }
  if (true_progressors > 0) {
    progression_sensitivity = confusion_matrix[4, 4] / true_progressors;
  }
  if (true_non_progressors > 0) {
    progression_specificity = sum(confusion_matrix[1:3, 1:3]) / true_non_progressors;
  }
  return (accuracy, response_accuracy, disease_control_accuracy,
          weighted_linear, weighted_quadratic,
          category_sensitivity, category_precision,
          response_sensitivity, response_specificity,
          progression_sensitivity, progression_specificity);
}


