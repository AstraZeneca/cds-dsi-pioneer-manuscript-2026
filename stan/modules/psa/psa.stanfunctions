// ============================================================================
// PSA-SPECIFIC FUNCTIONS
// ============================================================================
// These functions are specific to PSA measurements. They convert
// the general 2-component log-space state (from state_space module) into
// PSA-specific quantities.
//
// Follows the same pattern as modules/tumor/tumor.stanfunctions

/**
 * Calculate mean log(PSA) from two-component log-space states
 *
 * When lambda=1, this is identical to calc_log_burden_mean:
 *   log(PSA) = log_sum_exp(state[1], state[2]) + log(psa_baseline)
 *
 * The two-component state represents:
 *   Component 1: Decreasing tumor burden (treatment effect)
 *   Component 2: Growing tumor burden (progression/resistance)
 *
 * @param patient_states Matrix of states [n_visits x 2]
 * @param psa_baseline Baseline PSA measurement (ng/mL)
 * @return Vector of log(PSA) means at each visit
 */
vector calc_log_psa_mean(matrix patient_states, real psa_baseline) {
  assert_equal(cols(patient_states), 2);

  return to_vector(log_sum_exp(patient_states[, 1], patient_states[, 2])) + log(psa_baseline);
}

/**
 * Standardize log(PSA) for use as a time-varying covariate.
 *
 * Converts a log(normalized PSA) value — i.e. log(PSA / baseline) from the
 * two-component state — into a standardized absolute log(PSA) suitable for
 * the multistate hazard model.
 *
 * Caps log_psa_normalized at 10 (PSA up to exp(10)× baseline ≈ 22000×) to
 * prevent the downstream log-hazard cap from binding during HMC warmup.
 *
 * @param log_psa_normalized  log(exp(state_d) + exp(state_g)) — ratio scale
 * @param log_baseline_psa    log(baseline PSA in ng/mL)
 * @param median_log_psa_obs  Population median of log(absolute PSA)
 * @param iqr_log_psa_obs     Population IQR of log(absolute PSA)
 * @return Standardized log(PSA) value
 */
real standardize_log_psa(real log_psa_normalized, real log_baseline_psa,
                         real median_log_psa_obs, real iqr_log_psa_obs) {
  real log_psa_abs = log_baseline_psa + fmin(log_psa_normalized, 10.0);
  return (log_psa_abs - median_log_psa_obs) / iqr_log_psa_obs;
}

// ============================================================================
// PCWG3 RESPONSE EVALUATION FUNCTIONS
// ============================================================================
// Functions for calculating PCWG3 (Prostate Cancer Working Group 3)
// response categories from PSA measurements.
//
// Categories:
//   1 = Undetectable (CR equivalent): PSA < threshold
//   2 = PSA50 (PR equivalent): >= 50% decrease from baseline
//   3 = Stable (SD equivalent): Neither PSA50 nor PSA-PD
//   4 = PSA-PD: >= 25% AND >= 2 ng/mL from nadir, confirmed >= 3 weeks later

/**
 * Calculate PCWG3 PSA response category with confirmation logic
 *
 * SAP Section 5.4.4 PSA Progression Criteria:
 * - Single nadir-based rule: >= 25% AND >= 2 ng/mL rise from nadir, after week 12
 * - Day 82 gate applied universally (no Scenario A/B split)
 * - Trigger date = first qualifying visit; values not required to be consecutive
 * - nadir initialised to baseline, so no PSA decline is required to trigger PD
 *
 * @param psa_trajectory Absolute PSA values (ng/mL) at each visit
 * @param visit_days Study day for each visit (Day 82 gate per SAP Section 5.4.4 and Appendix D)
 * @param pre_nadir Pre-existing nadir from previous visits (0 if none)
 * @param n_screening Number of screening visits before treatment
 * @param psa_undetectable_threshold Threshold for undetectable (typically 0.1 ng/mL)
 * @return Array of PCWG3 categories for post-treatment visits
 */
array[] int calculate_psa_category(
  vector psa_trajectory,
  array[] int visit_days,
  real pre_nadir,
  int n_screening,
  real psa_undetectable_threshold
) {
  int n = rows(psa_trajectory);
  assert_greater_than_or_equal(n, n_screening);
  int n_treat = n - n_screening;
  array[n_treat] int psa_status;

  real baseline = psa_trajectory[n_screening];
  // nadir initialised to baseline; when PSA never declines, nadir == baseline,
  // so the single nadir-based rule covers both the "decline" and "no decline"
  // cases without special-casing (SAP Section 5.4.4, Issue #56).
  real nadir = pre_nadir <= 0 ? baseline : pre_nadir;
  int pending_pd_day = -1;

  int CR = 1; int PSA50 = 2; int STABLE = 3; int PSA_PD = 4;

  for (t in (n_screening + 1):n) {
    real psa_t = psa_trajectory[t];
    int day_t = visit_days[t];
    int idx = t - n_screening;

    // Update nadir
    if (psa_t < nadir) {
      nadir = psa_t;
    }

    // SAP Section 5.4.4: single nadir-based rule with Day 82 gate applied
    // universally — no Scenario A/B split. SAP Appendix D: Day 82 = start of
    // the Week 13 visit window.
    int meets_pd_criteria = (day_t >= 82) &&
                            (nadir > 0) &&
                            ((psa_t - nadir) / nadir >= 0.25) &&
                            ((psa_t - nadir) >= 2.0);

    // Handle confirmation requirement (>= 21 days between trigger and confirmer)
    if (meets_pd_criteria) {
      if (pending_pd_day > 0 && (day_t - pending_pd_day) >= 21) {
        // Confirmed progression
        psa_status[idx] = PSA_PD;
      } else {
        if (pending_pd_day < 0) {
          pending_pd_day = day_t;
        }
        // Not yet confirmed - assign based on other criteria
        if (psa_t < psa_undetectable_threshold) {
          psa_status[idx] = CR;
        } else if (baseline > 0 && (baseline - psa_t) / baseline >= 0.5) {
          psa_status[idx] = PSA50;
        } else {
          psa_status[idx] = STABLE;
        }
      }
    } else {
      // SAP Section 5.4.4: values not required to be consecutive —
      // a PSA dip between trigger and confirmation does NOT invalidate the trigger.
      // Do NOT reset pending_pd_day here.
      if (psa_t < psa_undetectable_threshold) {
        psa_status[idx] = CR;
      } else if (baseline > 0 && (baseline - psa_t) / baseline >= 0.5) {
        psa_status[idx] = PSA50;
      } else {
        psa_status[idx] = STABLE;
      }
    }
  }
  return psa_status;
}

/**
 * Simplified overload without pre-existing nadir
 */
array[] int calculate_psa_category(
  vector psa_trajectory,
  array[] int visit_days,
  int n_screening,
  real psa_undetectable_threshold
) {
  return calculate_psa_category(psa_trajectory, visit_days, 0, n_screening, psa_undetectable_threshold);
}

/**
 * Batched PCWG3 classification for all patients.
 *
 * Mirrors calculate_all_patients_recist: takes flat log-PSA vectors indexed by
 * position arrays and returns flat output arrays sized for all patients.
 *
 * rep_pcwg3 covers all observed visits (screening slots filled with NE=5).
 * forecast_obs_pcwg3 covers assessment-visit forecast positions only.
 *
 * @param rep_patient_log_psa       Log PSA at observed visits (flat, all patients)
 * @param forecast_patient_log_psa  Log PSA at weekly forecast visits (flat, all patients)
 * @param patient_visit_pos         Position array for observed visits
 * @param forecast_visits_pos       Position array for weekly forecast visits
 * @param forecast_obs_visits_pos   Position array for assessment-visit forecast
 * @param n_patient_screening_visits Screening visits per patient
 * @param t_patient_visits_day      Study days at observed visits (flat, all patients)
 * @param patient_last_obs_visit    Last observed visit week per patient
 * @param forecast_observation_interval  Weeks between assessments (typically 6)
 * @param last_predict_visit        Maximum forecast week
 * @param psa_undetectable_threshold  CR threshold (typically 0.1 ng/mL)
 */
tuple(array[] int, array[] int) calculate_all_patients_pcwg3(
  vector rep_patient_log_psa,
  vector forecast_patient_log_psa,
  array[] int patient_visit_pos,
  array[] int forecast_visits_pos,
  array[] int forecast_obs_visits_pos,
  array[] int n_patient_screening_visits,
  array[] int t_patient_visits_day,
  array[] int patient_last_obs_visit,
  int forecast_observation_interval,
  int last_predict_visit,
  real psa_undetectable_threshold
) {
  int n_patients = size(patient_visit_pos) - 1;
  int n_total_visits = get_pos_total_size(patient_visit_pos);
  int n_total_forecast_obs_visits = get_pos_total_size(forecast_obs_visits_pos);

  array[n_total_visits] int rep_pcwg3 = rep_array(5, n_total_visits);
  array[n_total_forecast_obs_visits] int forecast_obs_pcwg3;

  for (i in 1:n_patients) {
    int visit_start, visit_end;
    (visit_start, visit_end) = get_pos(patient_visit_pos, i);
    int visit_size = visit_end - visit_start + 1;
    int n_screening = n_patient_screening_visits[i];
    int n_treat = visit_size - n_screening;

    vector[visit_size] rep_psa_abs = exp(rep_patient_log_psa[visit_start:visit_end]);

    // Replicated PCWG3 at observed treatment visits
    if (n_treat > 0) {
      rep_pcwg3[(visit_start + n_screening):visit_end] = calculate_psa_category(
        rep_psa_abs,
        t_patient_visits_day[visit_start:visit_end],
        n_screening,
        psa_undetectable_threshold
      );
    }

    // Assessment-visit PCWG3 (subsampled from noisy weekly forecast)
    int n_assessment = get_pos_size(forecast_obs_visits_pos, i);
    if (n_assessment > 0) {
      int assess_start, assess_end;
      (assess_start, assess_end) = get_pos(forecast_obs_visits_pos, i);

      int fcast_start, fcast_end;
      (fcast_start, fcast_end) = get_pos(forecast_visits_pos, i);

      // Subsample weekly forecast at assessment-visit indices
      array[n_assessment] int obs_indices = linspaced_int_array(
        n_assessment,
        fcast_start + forecast_observation_interval - 1,
        fcast_start + n_assessment * forecast_observation_interval - 1
      );
      obs_indices[n_assessment] = fcast_end;

      // PSA trajectory: pre-treatment baseline + assessment visits
      // combined_psa[1] anchors the PSA50 baseline (must be pre-treatment, not last treatment PSA)
      vector[1 + n_assessment] combined_psa;
      combined_psa[1] = rep_psa_abs[n_screening];
      combined_psa[2:] = exp(forecast_patient_log_psa[obs_indices]);

      // Days: last observed day + assessment visit days
      array[1 + n_assessment] int combined_days;
      combined_days[1] = (patient_last_obs_visit[i] - 1) * 7 + 4;
      for (a in 1:n_assessment) {
        int week = min(patient_last_obs_visit[i] + a * forecast_observation_interval, last_predict_visit);
        combined_days[a + 1] = (week - 1) * 7 + 4;
      }

      // Nadir from observed treatment period (or last observed if no treatment visits)
      real obs_nadir = n_treat > 0
        ? min(rep_psa_abs[(n_screening + 1):visit_size])
        : rep_psa_abs[visit_size];

      forecast_obs_pcwg3[assess_start:assess_end] = calculate_psa_category(
        combined_psa, combined_days, obs_nadir, 1, psa_undetectable_threshold
      );
    }
  }

  return (rep_pcwg3, forecast_obs_pcwg3);
}
